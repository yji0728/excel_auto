{
  "name": "데이터_정렬_및_필터",
  "description": "데이터를 정렬하고 특정 조건으로 필터링하는 워크플로우",
  "steps": [
    {
      "operation": "open_file",
      "params": {
        "file_path": "data.xlsx"
      }
    },
    {
      "operation": "sort_data",
      "params": {
        "column": "날짜",
        "ascending": false
      }
    },
    {
      "operation": "filter_data",
      "params": {
        "column": "금액",
        "operator": ">",
        "value": 1000
      }
    },
    {
      "operation": "save_file",
      "params": {
        "file_path": "filtered_data.xlsx"
      }
    }
  ]
}
